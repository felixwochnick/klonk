# Gemeinsame Umgebung für apps/app und apps/admin (per --dotenv geladen)
# Postgres (siehe docker/docker-compose.dev.yml)
NUXT_DATABASE_URL=postgres://klonk:klonk@localhost:5432/klonk
# Je z. B. `openssl rand -base64 32` – NUXT_APP_SECRET versiegelt die Session-Cookies (für app und admin gleich setzen)
NUXT_APP_SECRET=
NUXT_ENCRYPTION_KEY=
# Öffentliche URLs (Produktion z. B. https://app.klonk.example / https://admin.klonk.example)
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_ADMIN_URL=http://localhost:3002
# Klonk ID (Authentik o. ä. OIDC): nur Betreiber-Login (Entwickler:innen, Besitzer:innen); Gruppen kommagetrennt
NUXT_PLATFORM_OIDC_ISSUER=
NUXT_PLATFORM_OIDC_CLIENT_ID=
NUXT_PLATFORM_OIDC_CLIENT_SECRET=
NUXT_PLATFORM_OIDC_OWNER_GROUPS=klonk-owners
NUXT_PLATFORM_OIDC_DEVELOPER_GROUPS=klonk-developers
# Privatkonten per OAuth (leer = Button ausgeblendet), Callback: <app-url>/auth/<anbieter>
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_MICROSOFT_CLIENT_ID=
NUXT_OAUTH_MICROSOFT_CLIENT_SECRET=
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_APPLE_CLIENT_ID=
NUXT_OAUTH_APPLE_TEAM_ID=
NUXT_OAUTH_APPLE_KEY_ID=
NUXT_OAUTH_APPLE_PRIVATE_KEY=
