# Gemeinsame Umgebung für apps/app und apps/admin (per --dotenv geladen)
# Postgres (siehe docker/docker-compose.dev.yml)
NUXT_DATABASE_URL=postgres://klonk:klonk@localhost:5432/klonk
# Je z. B. `openssl rand -base64 32` – NUXT_APP_SECRET versiegelt die Session-Cookies (für app und admin gleich setzen)
NUXT_APP_SECRET=
NUXT_ENCRYPTION_KEY=
