# Klonk-Proxy: leitet *.{$KLONK_DOMAIN} an die Dienste weiter.
# TLS-Modus über KLONK_TLS (siehe entrypoint.sh):
#   internal – eigene lokale CA (selbst signiert, z. B. für *.klonk.localhost)
#   http     – Let's Encrypt per HTTP-Challenge (Ports 80/443 müssen erreichbar sein)
#   ionos    – Let's Encrypt per DNS-Challenge über die IONOS-API (auch hinter Firewall/NAT)
#   off      – nur HTTP, wenn bereits ein anderer Proxy TLS übernimmt
# Zugangssperre über KLONK_GATE (z. B. für eine geschlossene Testphase):
#   off       – alles öffentlich (Standard)
#   authentik – Forward-Auth über einen Authentik-Outpost (KLONK_GATE_URL, z. B. http://authentik-outpost:9000)
# Einzelne Seiten ausnehmen: KLONK_GATE_WEBSITE / KLONK_GATE_DOCS / KLONK_GATE_ADMIN = off (Standard on); App und Anmeldung bleiben gesperrt.
{
	email {$KLONK_ACME_EMAIL}
	# Kein automatisches Eintragen der lokalen CA in den Container-Truststore
	skip_install_trust
}

(tls-internal) {
	tls internal
}

(tls-http) {
	tls {$KLONK_ACME_EMAIL}
}

(tls-ionos) {
	tls {
		dns ionos {env.IONOS_API_TOKEN}
		propagation_timeout 10m
	}
}

(tls-off) {
}

(gate-off) {
}

(gate-off-open) {
}

# Provider „Forward auth (domain level)“ in Authentik: Cookie-Domain = KLONK_DOMAIN, Zugriff über Gruppen-Bindung.
# Der Outpost erkennt die Anwendung am ursprünglichen Host ⇒ Host-Header nicht umschreiben (eigener Outpost im Docker-Netz)
(gate-authentik) {
	# Rücksprung nach der Anmeldung geht an den Outpost
	handle /outpost.goauthentik.io/* {
		reverse_proxy {$KLONK_GATE_URL}
	}
	# Webhooks (Mollie, Invoice Ninja) und Lizenz-API der Website bleiben erreichbar
	@gated not path /outpost.goauthentik.io/* /api/webhooks/* /api/v1/*
	forward_auth @gated {$KLONK_GATE_URL} {
		uri /outpost.goauthentik.io/auth/caddy
	}
}

# Offene Hauptdomain bei gesperrten Subdomains: Der Rücksprung des Outposts kann auf die Hauptdomain zeigen
# (Authentifizierungs-URL des Providers) ⇒ nur diesen Pfad weiterleiten, sonst keine Sperre
(gate-authentik-open) {
	handle /outpost.goauthentik.io/* {
		reverse_proxy {$KLONK_GATE_URL}
	}
}

(base) {
	import tls-{$KLONK_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(common) {
	import base
	import gate-{$KLONK_GATE}
}

{$KLONK_SCHEME}://app.{$KLONK_DOMAIN} {
	import common
	reverse_proxy app:3000
}

{$KLONK_SCHEME}://admin.{$KLONK_DOMAIN} {
	import base
	import gate-{$KLONK_GATE_ADMIN_SITE}
	reverse_proxy admin:3000
}

{$KLONK_SCHEME}://auth.{$KLONK_DOMAIN} {
	import common
	reverse_proxy auth:3000
}

{$KLONK_SCHEME}://docs.{$KLONK_DOMAIN} {
	import base
	import gate-{$KLONK_GATE_DOCS_SITE}
	root * /srv/docs
	redir / /de
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Hauptdomain: Website (KLONK_WEBSITE_UPSTREAM, z. B. `web:3000` aus dem privaten Repo klonk-web), sonst zur App
{$KLONK_SCHEME}://{$KLONK_DOMAIN} {
	import base
	import gate-{$KLONK_GATE_SITE}
	@nosite expression `{env.KLONK_WEBSITE_UPSTREAM} == ""`
	handle @nosite {
		redir {$KLONK_SCHEME}://app.{$KLONK_DOMAIN}{uri}
	}
	handle {
		reverse_proxy {env.KLONK_WEBSITE_UPSTREAM}
	}
}

# Zusätzliche Seiten, z. B. Test-Anmeldedienste im lokalen Stack (docker/local/sso.caddy)
import /etc/caddy/sites/*.caddy
# Eigene Seiten des Betriebs aus docker/proxy/sites/ (siehe README dort)
import /etc/caddy/sites.d/*.caddy
