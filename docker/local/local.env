# Lokaler Komplett-Stack unter *.klonk.localhost mit selbst signierten Zertifikaten (nur zum Testen!)
KLONK_DOMAIN=klonk.localhost
# Eigene Image-Tags, damit lokale Builds keine geladenen Release-Images überschreiben
KLONK_VERSION=local
KLONK_TLS=internal
KLONK_APP_SECRET=local-only-app-secret-do-not-use-in-production
KLONK_ENCRYPTION_KEY=local-only-encryption-key-do-not-use-in-production
POSTGRES_PASSWORD=klonk

# Klonk ID gegen den Test-IdP (Dex unter sso.klonk.localhost, Gruppe `admins` ⇒ Besitzer:in)
KLONK_ID_ISSUER=https://sso.klonk.localhost/dex
KLONK_ID_CLIENT_ID=klonk
KLONK_ID_CLIENT_SECRET=klonk-dev-secret
KLONK_ID_SCOPES=openid profile email groups
KLONK_ID_OWNER_GROUPS=admins
