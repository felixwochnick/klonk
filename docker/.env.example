# Konfiguration für docker/docker-compose.yml – kopieren nach docker/.env

# Domain: DNS-Einträge *.klonk.example und klonk.example zeigen auf diesen Server
KLONK_DOMAIN=klonk.example

# TLS-Zertifikate: internal (selbst signiert) | http (Let's Encrypt, HTTP-Challenge)
#                  | ionos (Let's Encrypt, DNS-Challenge über IONOS-API) | off (TLS macht ein anderer Proxy)
KLONK_TLS=http
KLONK_ACME_EMAIL=admin@klonk.example
# Nur für KLONK_TLS=ionos: API-Schlüssel aus https://developer.hosting.ionos.de (Format <prefix>.<secret>)
IONOS_API_TOKEN=
# Bei KLONK_TLS=off: Schema, unter dem der vorgelagerte Proxy die Seiten ausliefert
KLONK_PUBLIC_SCHEME=https

# Secrets – je `openssl rand -base64 32`
KLONK_APP_SECRET=
KLONK_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Optional: Lizenz-Token (sonst in der Verwaltung unter „Lizenz“ eintragen)
KLONK_LICENSE_TOKEN=
# Optional: Shop/Lizenzserver – Tokens werden dann automatisch verlängert (false = nie nach außen verbinden)
KLONK_SHOP_URL=
KLONK_LICENSE_AUTO_REFRESH=true
# Optional: Website (privates Repo klonk-web) auf der Hauptdomain, z. B. web:3000, und deren Origin für die Anmeldung
KLONK_WEBSITE_UPSTREAM=
KLONK_WEBSITE_URLS=
# Nur gehostete Plattform: Schlüssel für den Lizenzabgleich mit dem Shop (= NUXT_PLATFORM_API_KEY in klonk-web)
KLONK_LICENSE_SERVER_API_KEY=

# Optional: KI-Assistent als Standard der Instanz (Organisationen können in der Verwaltung eigene Werte setzen)
# KLONK_AI_MODE=server | webllm | off (leer + KLONK_AI_BASE_URL gesetzt = server)
KLONK_AI_MODE=
# OpenAI-kompatibler Endpunkt, z. B. https://api.openai.com/v1 oder http://ollama:11434/v1
KLONK_AI_BASE_URL=
KLONK_AI_MODEL=
KLONK_AI_API_KEY=
# Nur für webllm, z. B. Qwen2.5-Coder-1.5B-Instruct-q4f16_1-MLC
KLONK_AI_WEBLLM_MODEL=
# tutor = Lernende bekommen nur Hinweise, full = volle Hilfe
KLONK_AI_STUDENTS=tutor

# Optional: Klonk ID (Authentik) für Entwickler:innen und Besitzer:innen
KLONK_ID_ISSUER=
KLONK_ID_CLIENT_ID=
KLONK_ID_CLIENT_SECRET=

# Optional: Privatkonten
KLONK_GOOGLE_CLIENT_ID=
KLONK_GOOGLE_CLIENT_SECRET=
KLONK_MICROSOFT_CLIENT_ID=
KLONK_MICROSOFT_CLIENT_SECRET=
KLONK_GITHUB_CLIENT_ID=
KLONK_GITHUB_CLIENT_SECRET=
